# Лабораторные параметры Kerberos-домена (изменять с осторожностью:
# realm/имена зашиты также в шаблоны конфигов и проверяются скриптом verify.sh)
DOMAIN=lab.test
REALM=LAB.TEST
KDC_HOST=kdc.lab.test
LDAP_HOST=ldap.lab.test
WEB_HOST=web.lab.test
CLIENT_HOST=client.lab.test

# IP-адреса в сети Docker-лаборатории
KDC_IP=172.30.10.10
LDAP_IP=172.30.10.20
CLIENT_IP=172.30.10.30
WEB_IP=172.30.10.40

# Мониторинг (Prometheus + Grafana)
PROMETHEUS_HOST=prometheus.lab.test
GRAFANA_HOST=grafana.lab.test
CADVISOR_HOST=cadvisor.lab.test
BLACKBOX_HOST=blackbox.lab.test
PROMETHEUS_IP=172.30.10.50
GRAFANA_IP=172.30.10.60
CADVISOR_IP=172.30.10.70
BLACKBOX_IP=172.30.10.80
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Grafana_Secret_2024

# Keycloak (профиль keycloak): федерация пользователей из OpenLDAP + SPNEGO
KEYCLOAK_HOST=keycloak.lab.test
KEYCLOAK_IP=172.30.10.90
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Keycloak_Secret_2024

# Пароли — ТОЛЬКО для лаборатории, не использовать в production
KDC_MASTER_KEY=LabMasterKey_2024
ADMIN_PASSWORD=Admin_Secret_2024
ALICE_PASSWORD=Alice_Secret_2024
LDAP_ADMIN_PASSWORD=LdapAdmin_Secret_2024
