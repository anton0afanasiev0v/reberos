# Лаборатория Kerberos: два узла + клиент (три compose-проекта).
# Общая Docker-сеть kerberos (172.30.11.0/24) создаётся compose-проектом
# Узла А; Узел Б и клиент подключаются к ней как external.

DOMAIN=lab.test

# --- Узел А (ORG1, ORG2) ---
ORG1_REALM=ORG1.TEST
ORG2_REALM=ORG2.TEST
KDC_A1_HOST=kdc-a1.lab.test
KDC_A2_HOST=kdc-a2.lab.test
LDAP_A_HOST=ldap-a.lab.test
WEB_A_HOST=web-a.lab.test
KEYCLOAK_A_HOST=keycloak-a.lab.test
PORTAL_A_HOST=portal-a.lab.test
KDC_A1_IP=172.30.11.11
KDC_A2_IP=172.30.11.12
LDAP_A_IP=172.30.11.20
WEB_A_IP=172.30.11.40
KEYCLOAK_A_IP=172.30.11.41
PORTAL_A_IP=172.30.11.42
WEB_A_PORT=8081
KC_A_REALM=lab-a

# --- Узел Б (ORG3, ORG4) ---
ORG3_REALM=ORG3.TEST
ORG4_REALM=ORG4.TEST
KDC_B3_HOST=kdc-b3.lab.test
KDC_B4_HOST=kdc-b4.lab.test
LDAP_B_HOST=ldap-b.lab.test
WEB_B_HOST=web-b.lab.test
KEYCLOAK_B_HOST=keycloak-b.lab.test
PORTAL_B_HOST=portal-b.lab.test
KDC_B3_IP=172.30.11.13
KDC_B4_IP=172.30.11.14
LDAP_B_IP=172.30.11.21
WEB_B_IP=172.30.11.50
KEYCLOAK_B_IP=172.30.11.51
PORTAL_B_IP=172.30.11.52
WEB_B_PORT=8082
KC_B_REALM=lab-b

# --- Изоляция организаций (LDAP-ветки ou=orgN) ---
# Семантика: orgN = realm ORG N (узел Б тоже org3/org4).
# Единый источник правды realm<->ou — эти per-node переменные.
LDAP_REALM_PRIMARY_A=ORG1.TEST
LDAP_OU_PRIMARY_A=org1
LDAP_REALM_SECONDARY_A=ORG2.TEST
LDAP_OU_SECONDARY_A=org2
LDAP_REALM_PRIMARY_B=ORG3.TEST
LDAP_OU_PRIMARY_B=org3
LDAP_REALM_SECONDARY_B=ORG4.TEST
LDAP_OU_SECONDARY_B=org4

# Keycloak-федерация смотрит всю ветку ou=people (обе организации узла):
# логины уникальны (orgNuserM), поэтому username_in_use не возникает.
KC_LDAP_OU=people

# --- Клиент ---
CLIENT_IP=172.30.11.30

# --- Пароли (только для лаборатории) ---
KDC_MASTER_KEY=LabMasterKey_2024
ADMIN_PASSWORD=Admin_Secret_2024
ALICE_PASSWORD=Alice_Secret_2024
LDAP_ADMIN_PASSWORD=LdapAdmin_Secret_2024
CROSS_REALM_KEY=CrossRealm_Lab_2024
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Keycloak_Secret_2024
PORTAL_CLIENT_SECRET=Portal_Secret_2024

# --- Рабочие пользователи организаций + админ узла ---
# Полный логин = <ou><base> (org1user1, org2user1, ... org4user5): uid уникален
# в деревне, поэтому Keycloak видит обе организации узла.
# Организации (ou=orgN) каждого узла.
ORG_OUS_A="org1 org2"
ORG_OUS_B="org3 org4"
# Индивидуальный пароль каждому логину: "логин=пароль ...". Один список на узел.
ORG_USER_PASSWORDS_A="org1user1=Org1User1_2024 org1user2=Org1User2_2024 org1user3=Org1User3_2024 org1user4=Org1User4_2024 org1user5=Org1User5_2024 org2user1=Org2User1_2024 org2user2=Org2User2_2024 org2user3=Org2User3_2024 org2user4=Org2User4_2024 org2user5=Org2User5_2024"
ORG_USER_PASSWORDS_B="org3user1=Org3User1_2024 org3user2=Org3User2_2024 org3user3=Org3User3_2024 org3user4=Org3User4_2024 org3user5=Org3User5_2024 org4user1=Org4User1_2024 org4user2=Org4User2_2024 org4user3=Org4User3_2024 org4user4=Org4User4_2024 org4user5=Org4User5_2024"
# «admin» (короткое имя) — админ узла: DN uid=admin,ou=admins + LDAP write.
NODE_ADMIN_PASSWORD=NodeAdmin_Secret_2024

# Полный список логинов системы (все узлы/организации) — только для отображения
# на портале. Порядок: узел А (org1, org2), затем узел Б (org3, org4).
SYSTEM_USERS="org1user1 org1user2 org1user3 org1user4 org1user5 org2user1 org2user2 org2user3 org2user4 org2user5 org3user1 org3user2 org3user3 org3user4 org3user5 org4user1 org4user2 org4user3 org4user4 org4user5"
