          <mxGeometry height="60" width="30" x="-380" y="670" as="geometry" />
        </mxCell>
        <mxCell id="net-lab" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;" value="Docker network: lab (172.30.10.0/24)" vertex="1">
          <mxGeometry height="1120" width="1360" x="200" y="40" as="geometry" />
        </mxCell>
        <mxCell id="kdc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="kdc.lab.test&#xa;MIT Kerberos (krb5kdc + kadmind)&#xa;:88,749,464&#xa;IP: ${KDC_IP}" vertex="1">
          <mxGeometry height="90" width="200" x="260" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ldap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="ldap.lab.test&#xa;OpenLDAP (slapd)&#xa;:389&#xa;IP: ${LDAP_IP}" vertex="1">
          <mxGeometry height="90" width="200" x="600" y="105" as="geometry" />
        </mxCell>
        <mxCell id="keycloak" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="keycloak.lab.test [profile: keycloak]&#xa;Keycloak 26 (OIDC, Kerberos/SPNEGO)&#xa;:8080 (dev)&#xa;IP: ${KEYCLOAK_IP}" vertex="1">
          <mxGeometry height="90" width="220" x="940" y="100" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" value="client.lab.test&#xa;krb5 + Python spnego-check.py&#xa;SPNEGO/Kerberos тесты" vertex="1">
          <mxGeometry height="80" width="200" x="160" y="250" as="geometry" />
        </mxCell>
        <mxCell id="web" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="web.lab.test [profile: apache]&#xa;Apache httpd + mod_auth_kerb&#xa;SPNEGO/Negotiate&#xa;:80 -&gt; 8080 на хосте&#xa;IP: 172.30.10.40" vertex="1">
          <mxGeometry height="100" width="240" x="-170" y="660" as="geometry" />
        </mxCell>
        <mxCell id="grafana" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="grafana.lab.test&#xa;Grafana 13.2.4&#xa;auth.proxy (X-WEBAUTH-USER)&#xa;serves under /grafana/&#xa;IP: ${GRAFANA_IP}" vertex="1">
          <mxGeometry height="90" width="240" x="-395" y="260" as="geometry" />
