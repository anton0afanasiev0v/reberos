<mxfile>
  <diagram id="kerberos-arch" name="Kerberos Architecture">
    <mxGraphModel dx="3674" dy="1259" grid="1" gridSize="10" guides="1" tooltips="0" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
