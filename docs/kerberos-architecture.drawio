        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;fillColor=#f9f9f9;strokeColor=#cccccc;" value="Легенда:&#xa;Синий — Kerberos/LDAP&#xa;Фиолетовый — Keycloak (profile)&#xa;Зелёный — Apache + SPNEGO&#xa;Жёлтый — Grafana&#xa;Оранжевый — Prometheus/Blackbox&#xa;Красный — cAdvisor" vertex="1">
