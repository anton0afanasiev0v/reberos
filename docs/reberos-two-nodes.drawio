<mxfile host="app.diagrams.net">
  <diagram id="reberos-two-nodes" name="Два узла: ORG1–ORG4">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="0" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="user" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Пользователь (Браузер)" vertex="1">
          <mxGeometry x="60" y="640" width="30" height="60" as="geometry" />
        </mxCell>

        <mxCell id="nodeA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;fontStyle=1;" value="УЗЕЛ А" vertex="1">
          <mxGeometry x="340" y="80" width="920" height="1000" as="geometry" />
        </mxCell>
        <mxCell id="apacheA" parent="nodeA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;" value="Apache / Web (SPNEGO)&#xa;вход в узел" vertex="1">
          <mxGeometry x="50" y="70" width="380" height="180" as="geometry" />
        </mxCell>
        <mxCell id="portalA" parent="apacheA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="Портал выбора организации&#xa;только ORG1, ORG2" vertex="1">
          <mxGeometry x="40" y="70" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="internalA" parent="nodeA" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=10;" value="Внутренние сервисы (не выходят наружу)" vertex="1">
          <mxGeometry x="50" y="300" width="380" height="280" as="geometry" />
