          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="75" y="1150" />
              <mxPoint x="1300" y="1150" />
              <mxPoint x="1300" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-user-kdcB3" edge="1" parent="1" source="user" target="kdcB3" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=12;" value="kinit user@ORG3.TEST → TGT">
          <mxGeometry relative="1" as="geometry">
