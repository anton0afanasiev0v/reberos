        <mxCell id="e-user-apacheA" edge="1" parent="1" source="user" target="apacheA" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="Уровень 1: HTTP + SPNEGO (с билетом)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="650" />
              <mxPoint x="300" y="240" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-user-kdcA1" edge="1" parent="1" source="user" target="kdcA1" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=12;" value="kinit user@ORG1.TEST → TGT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="75" y="125" />
              <mxPoint x="1030" y="125" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-apacheA-kdcA1" edge="1" parent="1" source="apacheA" target="kdcA1" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=12;" value="AS/TGS напрямую">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="805" y="240" />
              <mxPoint x="805" y="365" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-apacheA-keycloakA" edge="1" parent="1" source="apacheA" target="keycloakA" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="OIDC: web-форма (логин/пароль)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-keycloakA-ldapA" edge="1" parent="1" source="keycloakA" target="ldapA" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="user federation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-keycloakA-apacheA" edge="1" parent="1" source="keycloakA" target="apacheA" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="OIDC-токен">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="365" y="480" />
              <mxPoint x="365" y="290" />
            </Array>
          </mxGeometry>
        </mxCell>

