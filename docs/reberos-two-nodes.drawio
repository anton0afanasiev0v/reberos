        <mxCell id="e-apacheB-keycloakB" edge="1" parent="1" source="apacheB" target="keycloakB" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="OIDC: web-форма (логин/пароль)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1690" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-keycloakB-ldapB" edge="1" parent="1" source="keycloakB" target="ldapB" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="user federation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-keycloakB-apacheB" edge="1" parent="1" source="keycloakB" target="apacheB" style="endArrow=block;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=12;" value="OIDC-токен">
          <mxGeometry relative="1" as="geometry">
