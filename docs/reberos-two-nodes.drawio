        <mxCell id="e-apacheB-kdcB3" edge="1" parent="1" source="apacheB" target="kdcB3" style="endArrow=block;html=1;rounded=0;dashed=1;labelBackgroundColor=#ffffff;fontSize=12;" value="AS/TGS напрямую">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
