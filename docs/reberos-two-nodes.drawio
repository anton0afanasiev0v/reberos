        <mxCell id="org4" parent="nodeB" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;" value="Организация ORG4 (ORG4.TEST)" vertex="1">
          <mxGeometry x="500" y="570" width="380" height="320" as="geometry" />
        </mxCell>
        <mxCell id="kdcB4" parent="nodeB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="KDC (MIT Kerberos)&#xa;ORG4.TEST :88" vertex="1">
          <mxGeometry x="60" y="170" width="260" height="90" as="geometry" />
