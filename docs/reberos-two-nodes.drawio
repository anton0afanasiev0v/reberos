        <mxCell id="keycloakA" parent="internalA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="Keycloak (общий)&#xa;OpenID Connect (web-форма: логин/пароль)" vertex="1">
          <mxGeometry x="30" y="50" width="320" height="100" as="geometry" />
        </mxCell>
