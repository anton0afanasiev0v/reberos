        <mxCell id="apacheB" parent="nodeB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;" value="Apache / Web (SPNEGO)&#xa;вход в узел" vertex="1">
