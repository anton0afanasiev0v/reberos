# Параметры нативного «Узла А» на Astra Linux SE 1.7 (2 организации = 2 realm'а).
#
# Использование:
#   sudo ./scripts/astra-node-a.sh --env deploy/astra-node-a.env
#
# Файл — обычный shell (KEY=VALUE), значения можно менять под свой домен.

# --- домен и realm'ы (две организации узла) ---
DOMAIN=lab.test
REALM_A=ORG1.TEST            # организация 1 (primary) — «домашний» realm узла
REALM_B=ORG2.TEST            # организация 2 (secondary)
NODE_IP=172.16.138.25        # адрес узла — нужен клиенту (astra-node-a-client.sh)

# --- имена сервисов (для /etc/hosts и SPN) ---
KDC_A_HOST=kdc-a1.lab.test
KDC_B_HOST=kdc-a2.lab.test
LDAP_HOST=ldap-a.lab.test

# --- каталог: ветки изоляции организаций ---
LDAP_OU_PRIMARY=org1
LDAP_OU_SECONDARY=org2
LDAP_OU_ADMINS=admins

# Служебный SPN каталога: регистрируется ТОЛЬКО в REALM_A
# (в REALM_B сервисных принципалов нет — так же, как в лаборатории у kdc-a2).
LDAP_SPN=ldap/ldap-a.lab.test

# --- пути (по умолчанию стандартные для Debian/Astra) ---
KDC_CONF_DIR=/etc/krb5kdc
KRB5_CONF=/etc/krb5.conf
KDC_DB_DIR_A=/var/lib/krb5kdc
KDC_DB_DIR_B=/var/lib/krb5kdc-ORG2
KEYTAB=/etc/krb5.keytab
SLAPD_CONF=/etc/ldap/slapd.conf
SLAPD_DATA=/var/lib/ldap
SLAPD_RUN=/run/slapd
SLAPD_UNIT=slapd-lab.service
SYSTEMD_UNIT_DIR=/etc/systemd/system

# --- секреты ---
KDC_MASTER_KEY=LabMasterKey_2024
CROSS_REALM_KEY=CrossRealm_Lab_2024
ADMIN_PASSWORD=Admin_Secret_2024
ALICE_PASSWORD=Alice_Secret_2024
LDAP_ADMIN_PASSWORD=LdapAdmin_Secret_2024
NODE_ADMIN_PASSWORD=NodeAdmin_Secret_2024

# --- пользователи узла (логин=пароль ...) ---
# Список общий для обоих realm'ов узла: в REALM_A и REALM_B создаются одни и те же
# логины (как в лаборатории: kdc-a1 и kdc-a2 получают один и тот же список).
# Ветку каталога (ou=orgN) определяет ПРЕФИКС логина, а не realm: realm задаёт
# правило authz-regexp, префикс — целевую ветку.
ORG_USER_PASSWORDS="org1user1=Org1User1_2024 org1user2=Org1User2_2024 org1user3=Org1User3_2024 org1user4=Org1User4_2024 org1user5=Org1User5_2024 org2user1=Org2User1_2024 org2user2=Org2User2_2024 org2user3=Org2User3_2024 org2user4=Org2User4_2024 org2user5=Org2User5_2024"
ORG_OUS="org1 org2"

# --- пакеты ---
# Список пакетов зашит в scripts/astra-node-a.sh (PKG_CRITICAL / PKG_OPTIONAL):
# критичные — krb5-kdc krb5-admin-server krb5-user slapd ldap-utils
# libsasl2-modules-gssapi-mit libpam-krb5; необязательный — sasl2-bin.
# Демон времени (chrony) ставится, только если его ещё нет: chrony и ntp
# конфликтуют с time-daemon, поэтому при наличии ntp/chrony ничего не трогаем.
PACKAGES="krb5-kdc krb5-admin-server krb5-user slapd ldap-utils sasl2-bin libsasl2-modules-gssapi-mit libpam-krb5"

# --- режимы безопасности Astra ---
# Скрипт НЕ трогает ЗПС/МКЦ автоматически: переключение уровня защищённости
# требует перезагрузки. Если apt не может поставить пакеты, выполните вручную:
#   sudo astra-modeswitch set 0        # базовый уровень, затем sudo reboot
#   sudo astra-mic-control disable     # только МКЦ, тоже нужна перезагрузка
# Либо запускайте установку с флагом --switch-base-level.

# ============================ Keycloak ============================
# Нативный Keycloak (без Docker), та же версия и тот же realm, что в лаборатории.
# Интернета на узле нет: дистрибутивы берём из vendor/ (см. vendor/README.md).

# Версия и оффлайн-дистрибутивы (пути относительно корня репозитория).
KEYCLOAK_VERSION=26.8.1
KEYCLOAK_TARBALL=vendor/keycloak-26.8.1.tar.gz
# Фолбэк-JRE, если в репозиториях Astra нет openjdk-17 (Keycloak 26 требует 17+).
JAVA_PACKAGE=openjdk-17-jre-headless
JAVA_TARBALL=vendor/temurin17-jre-x64-linux.tar.gz

# Куда ставим и от чого запускаем.
KEYCLOAK_HOME=/opt/keycloak
KEYCLOAK_DATA_DIR=/var/lib/keycloak
KEYCLOAK_ETC_DIR=/etc/keycloak
KEYCLOAK_USER=keycloak
KEYCLOAK_GROUP=keycloak
KEYCLOAK_UNIT=keycloak.service
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_RELATIVE_PATH=/auth      # как в лаборатории: Keycloak живёт под /auth
KEYCLOAK_START_TIMEOUT=120        # сколько ждём подъёма (секунды)

# Realm и его параметры (как в compose-файле лаборатории).
KC_REALM=lab-a
KEYCLOAK_NODE_LABEL="Узел А"
KEYCLOAK_HOST=keycloak-a.lab.test
WEB_HOST=web-a.lab.test
WEB_PORT=8081
PUBLIC_WEB_BASE=http://web-a.lab.test:8081
PORTAL_CLIENT_SECRET=Portal_Secret_2024
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=Keycloak_Secret_2024
