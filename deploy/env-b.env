# Переопределения окружения для УЗЛА Б (схема «два хоста», network_mode: host).
#
#   docker compose --env-file .env --env-file deploy/env-b.env \
#       -f compose-node-b.yml -f compose-node-b.host.yml up -d
#
# В host-network порт Apache = 80 (в демо-режиме это 127.0.0.1:8082).
# IP соседнего хоста нужен скриптам (рендер фрагмента /etc/hosts).

IMAGE_PREFIX=lab
IMAGE_TAG=1

WEB_B_PORT=80

# IP хоста Узла А (канал между хостами)
PEER_A_IP=10.0.0.1
