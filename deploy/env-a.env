# Переопределения окружения для УЗЛА А (схема «два хоста», network_mode: host).
#
#   docker compose --env-file .env --env-file deploy/env-a.env \
#       -f compose-node-a.yml -f compose-node-a.host.yml up -d
#
# В host-network порт Apache = 80 (в демо-режиме это 127.0.0.1:8081).
# IP соседнего хоста нужен скриптам (рендер фрагмента /etc/hosts).

IMAGE_PREFIX=lab
IMAGE_TAG=1

WEB_A_PORT=80

# IP хоста Узла Б (канал между хостами)
PEER_B_IP=10.0.0.2
