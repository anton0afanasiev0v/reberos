# Фрагмент /etc/hosts для ПК оператора (схема «два хоста»).
#
#   sudo tee -a /etc/hosts < deploy/hosts-client.fragment
#
# Нужно, чтобы браузер и kinit на ПК обращались к сервисам по тем же
# именам, что и в principal'ах (HTTP/web-a.lab.test, ldap/ldap-b.lab.test):
# подмена имени на IP ломает SPNEGO (билет выдаётся на имя из URL).

10.0.0.1 kdc-a1.lab.test kdc-a2.lab.test ldap-a.lab.test web-a.lab.test keycloak-a.lab.test portal-a.lab.test
10.0.0.2 kdc-b3.lab.test kdc-b4.lab.test ldap-b.lab.test web-b.lab.test keycloak-b.lab.test portal-b.lab.test
